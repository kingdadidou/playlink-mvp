{
  "expo": {
    "name": "PlayLink",
    "slug": "playlink",
    "version": "1.0.0",
    "scheme": "playlink",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f7f5ed"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kingdadidou.playlink",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kingdadidou.playlink",
      "adaptiveIcon": {
        "backgroundColor": "#174c3e",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      ["expo-image-picker", {"photosPermission":"Choisis une photo pour ton profil PlayLink.","cameraPermission":false,"microphonePermission":false}],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "0bee99b0-cace-4454-9f86-bf1358d869c5"
      }
    },
    "owner": "fabienlebrun"
  }
}
